<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.gravere.bybus.installprobe">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application android:label="Installer inspection" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".InstallProbe" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".InstallProbe$ApkProvider"
            android:authorities="io.github.gravere.bybus.installprobe.apk"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
