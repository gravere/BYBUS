<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="io.github.gravere.bybus" /></queries>
    <permission android:name="com.example.limbuszhcn.permission.BYBUS_MIGRATION" android:protectionLevel="signature" />
    <application android:allowBackup="false" android:label="BYBUS（旧版）" android:icon="@drawable/app_icon"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".LegacyMigrationActivity" android:exported="true" />
        <!-- Keep the original launcher component so pinned icons and update returns remain valid. -->
        <activity-alias android:name="com.example.limbuszhcn.MainActivity"
            android:targetActivity=".LegacyMigrationActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <provider android:name=".LegacyMigrationProvider" android:exported="true"
            android:authorities="com.example.limbuszhcn.bybus.migration"
            android:permission="com.example.limbuszhcn.permission.BYBUS_MIGRATION" />
    </application>
</manifest>
