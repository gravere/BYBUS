<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
        <TextView android:id="@+id/ai_notice_label" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="13sp"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"
            android:textAppearance="@android:style/TextAppearance.Material.Notification" />
        <Chronometer android:id="@+id/ai_notice_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textAppearance="@android:style/TextAppearance.Material.Notification.Time" />
        <TextView android:id="@+id/ai_notice_stop" android:layout_width="48dp" android:layout_height="match_parent" android:maxLines="1" android:textSize="13sp"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"
            android:gravity="center" android:text="暂停" android:contentDescription="暂停翻译并保存进度"
            android:textColor="@color/ai_notice_accent"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
        <TextView android:id="@+id/ai_notice_cancel" android:layout_width="48dp" android:layout_height="match_parent" android:maxLines="1" android:textSize="13sp"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"
            android:gravity="center" android:text="取消" android:contentDescription="取消翻译任务，需确认"
            android:textColor="@color/ai_notice_cancel"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
    </LinearLayout>
    <ProgressBar android:id="@+id/ai_notice_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp"
        android:progressTint="@color/ai_notice_accent" android:progressBackgroundTint="@color/ai_notice_track" />
</LinearLayout>
